#include <stdio.h>
#include <stdlib.h>
#include <time.h>
int sum_matrix(int *A, int N) {
	int i;
    int sum = 0;
    for ( i = 0; i < N * N; i++) {
        sum += A[i];
    }
    return sum;
}
void fill_matrix(int *A, int N) {
	int i;
    for (i = 0; i < N * N; i++) {
        A[i] = rand() % 10;
    }
}
void write_matrix(FILE *f, int *A, int N) {
	int i;
	int j;
    for ( i = 0; i < N; i++) {
        for ( j = 0; j < N; j++) {
            fprintf(f, "%d ", A[i * N + j]);
        }
        fprintf(f, "\n");
    }
}

int main() {
    clock_t start_time = clock();
    srand(time(NULL));
    FILE *f_date = fopen("date.txt", "r");
    if (!f_date) {

        f_date = fopen("date.txt", "w");
        fprintf(f_date, "25 12 2026\n");
        fclose(f_date);
        f_date = fopen("date.txt", "r");
    }
    
    int day, month, year;
    fscanf(f_date, "%d %d %d", &day, &month, &year);
    fclose(f_date);
    int days = (year - 2026) * 365 + (month - 6) * 30 + (day - 18);
    printf("Date from file: %d.%d.%d\n", day, month, year);
    printf("Days until date: %d\n\n", days);
    int N;
    printf("Enter matrix size N (NxN): ");
    scanf("%d", &N);
    int *matrix1 = (int*)malloc(N * N * sizeof(int));
    int *matrix2 = (int*)malloc(N * N * sizeof(int));

    int sum1, sum2;
    do {

        fill_matrix(matrix1, N);
        fill_matrix(matrix2, N);

        sum1 = sum_matrix(matrix1, N);
        sum2 = sum_matrix(matrix2, N);

    } while (sum1 != sum2);

    printf("Found two matrices with equal sum!\n");
    printf("Sum = %d\n\n", sum1);

    FILE *f_out = fopen("output.txt", "w");
    if (!f_out) {
        printf("Error creating output file!\n");
        return 1;
    }

    fprintf(f_out, "Variant 1\n");
    fprintf(f_out, "Date: %d.%d.%d\n", day, month, year);
    fprintf(f_out, "Days until date: %d\n\n", days);

    fprintf(f_out, "Matrix size: %dx%d\n", N, N);
    fprintf(f_out, "Sum of elements: %d\n\n", sum1);

    fprintf(f_out, "Matrix 1:\n");
    write_matrix(f_out, matrix1, N);
    
    fprintf(f_out, "\nMatrix 2:\n");
    write_matrix(f_out, matrix2, N);

    fclose(f_out);

    free(matrix1);
    free(matrix2);


    double cpu_time = ((double)(clock() - start_time)) / CLOCKS_PER_SEC;
    printf("Results written to output.txt\n");
    printf("Program time: %f seconds\n", cpu_time);

    return 0;
}
