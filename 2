#include <stdio.h>
#include <stdlib.h>
#include <time.h>

void add_matrices(int *A, int *B, int *C, int n) {
    int i;
    for (i = 0; i < n * n; i++) {
        C[i] = A[i] + B[i];
    }
}

void multiply_matrices(int *A, int *B, int *C, int n) {
    int i, j, k;
    for (i = 0; i < n; i++) {
        for (j = 0; j < n; j++) {
            C[i * n + j] = 0;
            for (k = 0; k < n; k++) {
                C[i * n + j] += A[i * n + k] * B[k * n + j];
            }
        }
    }
}

void write_matrix(FILE *f, int *m, int n) {
    int i, j;
    for (i = 0; i < n; i++) {
        for (j = 0; j < n; j++) {
            fprintf(f, "%d ", m[i * n + j]);
        }
        fprintf(f, "\n");
    }
}

int main() {
    int i, j;
    clock_t start = clock();
    srand(time(NULL));
    
    int n;
    printf("Enter matrix size n: ");
    scanf("%d", &n);
    
    int *mat1 = (int*)malloc(n * n * sizeof(int));
    int *mat2 = (int*)malloc(n * n * sizeof(int));
    
    for (i = 0; i < n * n; i++) {
        mat1[i] = rand() % 10;
        mat2[i] = rand() % 10;
    }
    
    FILE *f = fopen("input.txt", "w");
    fprintf(f, "%d\n", n);
    write_matrix(f, mat1, n);
    fprintf(f, "\n");
    write_matrix(f, mat2, n);
    fclose(f);
    
    free(mat1);
    free(mat2);
    mat1 = NULL;
    mat2 = NULL;
    

    
    f = fopen("input.txt", "r");
    int size;
    fscanf(f, "%d", &size);
    
    mat1 = (int*)malloc(size * size * sizeof(int));
    mat2 = (int*)malloc(size * size * sizeof(int));
    
    for (i = 0; i < size * size; i++) {
        fscanf(f, "%d", &mat1[i]);
    }
    for (i = 0; i < size * size; i++) {
        fscanf(f, "%d", &mat2[i]);
    }
    fclose(f);
    
    int *sum_mat = (int*)malloc(size * size * sizeof(int));
    int *mul_mat = (int*)malloc(size * size * sizeof(int));
    
    add_matrices(mat1, mat2, sum_mat, size);
    multiply_matrices(mat1, mat2, mul_mat, size);
    
    f = fopen("output.txt", "w");
    fprintf(f, "Sum of matrices:\n");
    write_matrix(f, sum_mat, size);
    fprintf(f, "\nProduct of matrices:\n");
    write_matrix(f, mul_mat, size);
    
    int min = mat1[0];
    int min_pos = 0;
    int odd_count = 0;
    
    for (i = 0; i < size * size; i++) {
        if (mat1[i] < min) {
            min = mat1[i];
            min_pos = i;
        }
        if (mat1[i] % 2 != 0) {
            odd_count++;
        }
    }
    
    fprintf(f, "\nTask 3:\n");
    fprintf(f, "Minimum element in matrix1: %d\n", min);
    fprintf(f, "Number of minimum element: %d\n", min_pos);
    fprintf(f, "Count of odd numbers in matrix1: %d\n", odd_count);
   
    int found_in_mat1 = 0;
    int found_in_mat2 = 0;
    
    for (i = 0; i < size && !found_in_mat1; i++) {
        int same = 1;
        for (j = 1; j < size; j++) {
            if (mat1[i * size + j] != mat1[i * size]) {
                same = 0;
                break;
            }
        }
        if (same) {
            fprintf(f, "\nTask 4: In matrix1 row %d has identical numbers\n", i + 1);
            found_in_mat1 = 1;
        }
    }
    
    for (j = 0; j < size && !found_in_mat1; j++) {
        int same = 1;
        for (i = 1; i < size; i++) {
            if (mat1[i * size + j] != mat1[j]) {
                same = 0;
                break;
            }
        }
        if (same) {
            fprintf(f, "\nTask 4: In matrix1 column %d has identical numbers\n", j + 1);
            found_in_mat1 = 1;
        }
    }
    
    for (i = 0; i < size && !found_in_mat2; i++) {
        int same = 1;
        for (j = 1; j < size; j++) {
            if (mat2[i * size + j] != mat2[i * size]) {
                same = 0;
                break;
            }
        }
        if (same) {
            fprintf(f, "\nTask 4: In matrix2 row %d has identical numbers\n", i + 1);
            found_in_mat2 = 1;
        }
    }
    
    for (j = 0; j < size && !found_in_mat2; j++) {
        int same = 1;
        for (i = 1; i < size; i++) {
            if (mat2[i * size + j] != mat2[j]) {
                same = 0;
                break;
            }
        }
        if (same) {
            fprintf(f, "\nTask 4: In matrix2 column %d has identical numbers\n", j + 1);
            found_in_mat2 = 1;
        }
    }
    
    if (!found_in_mat1 && !found_in_mat2) {
        fprintf(f, "\nTask 4: No matrices with identical numbers in row or column\n");
    }
    
    fclose(f);
    
    free(mat1);
    free(mat2);
    free(sum_mat);
    free(mul_mat);
    
    clock_t end = clock();
    double time_spent = (double)(end - start) / CLOCKS_PER_SEC;
    
    printf("\n Program execution time: %f seconds\n", time_spent);
    printf(" results in output.txt\n");
    
    return 0;
}
