#include <stdio.h>
#include <stdlib.h>
#include <time.h>

void add_matrices(int *A, int *B, int *Res, int N) {
    for (int i = 0; i < N * N; i++) {
        Res[i] = A[i] + B[i];
    }
}

void multiply_matrices(int *A, int *B, int *Res, int N) {
    for (int i = 0; i < N; i++) {
        for (int j = 0; j < N; j++) {
            int sum = 0;
            for (int k = 0; k < N; k++) {
                sum += A[i * N + k] * B[k * N + j];
            }
            Res[i * N + j] = sum;
        }
    }
}

int main() {
    int N;
    
    printf("Enter the size of square matrices N (matrices will be NxN): ");
    scanf("%d", &N);

    clock_t start_time = clock();
    srand(time(NULL));

    int *matrix1 = (int*)malloc(N * N * sizeof(int));
    int *matrix2 = (int*)malloc(N * N * sizeof(int));

    for (int i = 0; i < N * N; i++) {
        matrix1[i] = rand() % 10;
        matrix2[i] = rand() % 10;
    }

    FILE *f_in = fopen("input.txt", "w");
    if (!f_in) {
        printf("Error creating file!\n");
        return 1;
    }
    
    fprintf(f_in, "%d\n", N);
    
    for (int i = 0; i < N; i++) {
        for (int j = 0; j < N; j++) fprintf(f_in, "%d ", matrix1[i * N + j]);
        fprintf(f_in, "\n");
    }
    fprintf(f_in, "\n");
    
    for (int i = 0; i < N; i++) {
        for (int j = 0; j < N; j++) fprintf(f_in, "%d ", matrix2[i * N + j]);
        fprintf(f_in, "\n");
    }
    fclose(f_in);

    free(matrix1);
    free(matrix2);
    matrix1 = NULL;
    matrix2 = NULL;

    f_in = fopen("input.txt", "r");
    int read_N;
    fscanf(f_in, "%d", &read_N);

    matrix1 = (int*)malloc(read_N * read_N * sizeof(int));
    matrix2 = (int*)malloc(read_N * read_N * sizeof(int));

    for (int i = 0; i < read_N * read_N; i++) fscanf(f_in, "%d", &matrix1[i]);
    for (int i = 0; i < read_N * read_N; i++) fscanf(f_in, "%d", &matrix2[i]);
    fclose(f_in);

    int *sum_matrix = (int*)malloc(read_N * read_N * sizeof(int));
    int *mul_matrix = (int*)malloc(read_N * read_N * sizeof(int));

    add_matrices(matrix1, matrix2, sum_matrix, read_N);
    multiply_matrices(matrix1, matrix2, mul_matrix, read_N);

    FILE *f_out = fopen("output.txt", "w");
    
    fprintf(f_out, "Addition result:\n");
    for (int i = 0; i < read_N; i++) {
        for (int j = 0; j < read_N; j++) fprintf(f_out, "%d\t", sum_matrix[i * read_N + j]);
        fprintf(f_out, "\n");
    }

    fprintf(f_out, "\nMultiplication result:\n");
    for (int i = 0; i < read_N; i++) {
        for (int j = 0; j < read_N; j++) fprintf(f_out, "%d\t", mul_matrix[i * read_N + j]);
        fprintf(f_out, "\n");
    }
    fclose(f_out);
    
    printf("\nCalculations completed successfully! Results are saved in output.txt\n");

    free(matrix1);
    free(matrix2);
    free(sum_matrix);
    free(mul_matrix);

    double cpu_time = ((double)(clock() - start_time)) / CLOCKS_PER_SEC;
    printf("Program execution time: %f seconds\n", cpu_time);

    return 0;
}
