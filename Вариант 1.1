#include <stdio.h>
#include <stdlib.h>
#include <time.h>

int main() {
    int N, M;
    
    printf("Enter the number of elements (N): ");
    scanf("%d", &N);
    printf("Enter the number of matrix columns (M): ");
    scanf("%d", &M);

    clock_t start_time = clock();
    srand(time(NULL));

    int *numbers = (int*)malloc(N * sizeof(int));
    for (int i = 0; i < N; i++) {
        numbers[i] = rand() % 100 + 1;
    }

    FILE *file_in = fopen("input.txt", "w");
    for (int i = 0; i < N; i++) {
        fprintf(file_in, "%d ", numbers[i]);
    }
    fclose(file_in);

    free(numbers);
    numbers = NULL;

    numbers = (int*)malloc(N * sizeof(int));
    file_in = fopen("input.txt", "r");
    for (int i = 0; i < N; i++) {
        fscanf(file_in, "%d", &numbers[i]);
    }
    fclose(file_in);

    FILE *file_out = fopen("output.txt", "w");
    for (int i = 0; i < N; i++) {
        if (numbers[i] % 35 == 0)      fprintf(file_out, "FIVESEVEN ");
        else if (numbers[i] % 5 == 0)  fprintf(file_out, "FIVE ");
        else if (numbers[i] % 7 == 0)  fprintf(file_out, "SEVEN ");
        else                           fprintf(file_out, "%d ", numbers[i]);
    }
    fclose(file_out);

    int rows = N / M;
    
    printf("\n--- Generated Matrix ---\n");
    for (int i = 0; i < rows; i++) {
        for (int j = 0; j < M; j++) {
            printf("%d\t", numbers[i * M + j]);
        }
        printf("\n");
    }

    if (rows > 0) {
        printf("\n--- Addition Results ---\n");
        for (int i = 0; i < rows; i++) {
            int row_sum = 0;
            for (int j = 0; j < M; j++) row_sum += numbers[i * M + j];
            printf("Sum of row %d: %d\n", i + 1, row_sum);
        }
        for (int j = 0; j < M; j++) {
            int col_sum = 0;
            for (int i = 0; i < rows; i++) col_sum += numbers[i * M + j];
            printf("Sum of column %d: %d\n", j + 1, col_sum);
        }
    }

    free(numbers);

    double cpu_time = ((double)(clock() - start_time)) / CLOCKS_PER_SEC;
    printf("\nProgram execution time: %f seconds\n", cpu_time);

    return 0;
}
