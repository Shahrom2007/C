#include <stdio.h>
////////////////////////////////////// Ôóíêöèÿ âû÷èñëåíèÿ ñóììû
int sum(int arr[], int count) {
	int i;
    int result = 0;
    for ( i = 0; i < count; i++) {
        result += arr[i];  // Ñêëàäûâàåì âñå ýëåìåíòû
    }
    return result;
}
/////////////////////////////////////////////////////////
int max(int arr[], int count) {
	int i;
    int result = arr[0];  // Áåð¸ì ïåðâûé ýëåìåíò
    for (i = 1; i < count; i++) {
        if (arr[i] > result) result = arr[i];  // Åñëè áîëüøå - îáíîâëÿåì
    }
    return result;
}
///////////////////////////////////////////////////////////////
int min(int arr[], int count) {
	int i;
    int result = arr[0];  // Áåð¸ì ïåðâûé ýëåìåíò
    for ( i = 1; i < count; i++) {
        if (arr[i] < result) result = arr[i];  // Åñëè ìåíüøå - îáíîâëÿåì
    }
    return result;
}
///////////////////////////////////////////////////////
double average(int arr[], int count) {
    int s = sum(arr, count);  // Ñ÷èòàåì ñóììó
    return (double)s / count;  // Äåëèì íà êîëè÷åñòâî
}
