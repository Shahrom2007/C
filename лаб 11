int main() {
    int count;
    printf("Enter the number of numbers: ");
    scanf("%d", &count);  // Ñ÷èòûâàåì êîëè÷åñòâî
//////////////////////////////////////////////////////////////////
    int arr[count];  // Ñîçäà¸ì ìàññèâ
    printf("Enter the numbers: ", count);
    int i;
    for ( i = 0; i < count; i++) {
        scanf("%d", &arr[i]);  // Ñ÷èòûâàåì êàæäîå ÷èñëî
    }
////////////////////////////////////////Âûâîäèì ðåçóëüòàòû
    printf("Sum: %d\n", sum(arr, count));
    printf("Max: %d\n", max(arr, count));
    printf("Min: %d\n", min(arr, count));
    printf("Average: %.2f\n", average(arr, count));
    return 0;
}
