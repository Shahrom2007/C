#include <stdio.h>
#include <stdlib.h>
#include <time.h>
// Функция для сложения матриц
void add_matrices(int *A, int *B, int *Res, int N) {
    for (int i = 0; i < N * N; i++) {
        Res[i] = A[i] + B[i];
    }
}
// Функция для умножения матриц
void multiply_matrices(int *A, int *B, int *Res, int N) {
    for (int i = 0; i < N; i++) {
        for (int j = 0; j < N; j++) {
            int sum = 0;
            for (int k = 0; k < N; k++) {
                sum += A[i * N + k] * B[k * N + j];
            }
            Res[i * N + j] = sum;
        }
    }
}
int main() {
    int N;
    // Запрос размера матриц у пользователя
    printf("Введите размер квадратных матриц N (матрицы будут NxN): ");
    scanf("%d", &N);

    // Начинаем замер времени
    clock_t start_time = clock();
    srand(time(NULL));

    // задание 1: Создание матриц, запись в файл и очистка ---
    // Выделяем память (используем одномерный массив для имитации двумерного)
    int *matrix1 = (int*)malloc(N * N * sizeof(int));
    int *matrix2 = (int*)malloc(N * N * sizeof(int));

    // Заполнение случайными числами от 0 до 9 (чтобы результат умножения не был слишком огромным)
    for (int i = 0; i < N * N; i++) {
        matrix1[i] = rand() % 10;
        matrix2[i] = rand() % 10;
    }

    FILE *f_in = fopen("input.txt", "w");
    if (!f_in) {
        printf("Ошибка создания файла!\n");
        return 1;
    }
    
    // Пишем размер в начало файла (чтобы потом было легко считать)
    fprintf(f_in, "%d\n", N);
    
    // Пишем первую матрицу
    for (int i = 0; i < N; i++) {
        for (int j = 0; j < N; j++) fprintf(f_in, "%d ", matrix1[i * N + j]);
        fprintf(f_in, "\n");
    }
    fprintf(f_in, "\n");
    
    // Пишем вторую матрицу
    for (int i = 0; i < N; i++) {
        for (int j = 0; j < N; j++) fprintf(f_in, "%d ", matrix2[i * N + j]);
        fprintf(f_in, "\n");
    }
    fclose(f_in); // Закрываем файл по условию задачи

    // "Отчистить массивы" по условию задачи
    free(matrix1);
    free(matrix2);
    matrix1 = NULL;
    matrix2 = NULL;

    // задание 2: Чтение из файла, вычисления и запись результата 
    f_in = fopen("input.txt", "r");
    int read_N;
    fscanf(f_in, "%d", &read_N); // Читаем размер

    // Снова выделяем память
    matrix1 = (int*)malloc(read_N * read_N * sizeof(int));
    matrix2 = (int*)malloc(read_N * read_N * sizeof(int));

    // Считываем обе матрицы
    for (int i = 0; i < read_N * read_N; i++) fscanf(f_in, "%d", &matrix1[i]);
    for (int i = 0; i < read_N * read_N; i++) fscanf(f_in, "%d", &matrix2[i]);
    fclose(f_in);

    // Массивы для хранения результатов сложения и умножения
    int *sum_matrix = (int*)malloc(read_N * read_N * sizeof(int));
    int *mul_matrix = (int*)malloc(read_N * read_N * sizeof(int));

    // Вызываем свои функции
    add_matrices(matrix1, matrix2, sum_matrix, read_N);
    multiply_matrices(matrix1, matrix2, mul_matrix, read_N);

    // Записываем результат в output.txt
    FILE *f_out = fopen("output.txt", "w");
    
    fprintf(f_out, "Результат сложения:\n");
    for (int i = 0; i < read_N; i++) {
        for (int j = 0; j < read_N; j++) fprintf(f_out, "%d\t", sum_matrix[i * read_N + j]);
        fprintf(f_out, "\n");
    }

    fprintf(f_out, "\nРезультат умножения:\n");
    for (int i = 0; i < read_N; i++) {
        for (int j = 0; j < read_N; j++) fprintf(f_out, "%d\t", mul_matrix[i * read_N + j]);
        fprintf(f_out, "\n");
    }
    fclose(f_out);
    
    printf("\nВычисления успешно завершены! Результаты записаны в файл output.txt\n");

    // Финальная очистка памяти
    free(matrix1);
    free(matrix2);
    free(sum_matrix);
    free(mul_matrix);

    // задание 3Замер времени 
    double cpu_time = ((double)(clock() - start_time)) / CLOCKS_PER_SEC;
    printf("Время работы программы: %f секунд\n", cpu_time);

    return 0;
}
