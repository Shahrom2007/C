#include <stdio.h>
#include <time.h>
#include <string.h>


// Äåíü íåäåëè (0=Âñ, 1=Ïí, ..., 6=Ñá)
int dayOfWeek(int y, int m, int d) {
    if (m < 3) { m += 12; y--; }
    int k = y % 100, j = y / 100;
    return (d + 13*(m+1)/5 + k + k/4 + j/4 + 5*j) % 7;
}

// Âèñîêîñíûé ãîä
int isLeap(int y) {
    return (y % 4 == 0 && y % 100 != 0) || (y % 400 == 0);
}

// Äíåé â ìåñÿöå
int daysInMonth(int y, int m) {
    int d[] = {31,28,31,30,31,30,31,31,30,31,30,31};
    if (m == 2 && isLeap(y)) return 29;
    return d[m-1];
}

// Ïå÷àòü ìåñÿöà
void printMonth(int y, int m) {
    const char *mn[] = {"","January","February","March","April","May","June",
                        "July","August","September","October","November","December"};
    int i;
    int d;
    printf("\n%s %d\n", mn[m], y);
    printf("Su Mo Tu We Th Fr Sa\n");
    int start = dayOfWeek(y, m, 1);
    for ( i = 0; i < start; i++) printf("   ");
    for ( d = 1; d <= daysInMonth(y, m); d++) {
        printf("%2d ", d);
        if ((start + d) % 7 == 0) printf("\n");
    }
    printf("\n");
}

// Ïå÷àòü ãîäà
void printYear(int y) {
	int m;
    for ( m = 1; m <= 12; m++) printMonth(y, m);
}

// Ðàçáîð äàòû èç ñòðîêè
int parseDate(char *s, int *y, int *m, int *d) {
    if (strcmp(s, "now") == 0) {
        time_t t = time(NULL);
        struct tm *now = localtime(&t);
        *y = now->tm_year + 1900;
        *m = now->tm_mon + 1;
        *d = now->tm_mday;
        return 1;
    }
    int n = sscanf(s, "%d.%d.%d", y, m, d);
    if (n == 1) { *m = *d = 0; return 1; }
    if (n == 2) { *d = 0; return 1; }
    if (n == 3) return 1;
    return 0;
}

int main() {
    char input[32];
    int y, m, d;
    
    printf("Enter date (yyyy.mm.dd / yyyy.mm / yyyy / now): ");
    fgets(input, sizeof(input), stdin);
    input[strcspn(input, "\n")] = 0;
    
    if (!parseDate(input, &y, &m, &d)) {
        printf("Invalid format\n");
        return 1;
    }
    
    if (d > 0) {
        // Äåíü íåäåëè
        const char *wd[] = {"Sunday","Monday","Tuesday","Wednesday",
                           "Thursday","Friday","Saturday"};
        printf("%s\n", wd[dayOfWeek(y, m, d)]);
    }
