#include <stdio.h>
#include <string.h>
#include <stdlib.h>
int main() {
    int i, j, k;
    char str[100];
    char *tokens[100];
    int count = 0;
    char nums[100][100];
    printf("enter expression (e.g., 1+2*3): ");
    scanf("%99[^\n]", str);
    char *token = strtok(str, " ");
    for (i = 0; token != NULL; i++) {
        tokens[count++] = token; 
        printf("token %d: %s\n", i, tokens[i]); 
        token = strtok(NULL, " ");
    }
    i = 0; 
    while (i < count) {
        if (strcmp(tokens[i], "*") == 0) {
            double left  = atof(tokens[i - 1]);
            double right = atof(tokens[i + 1]);
            double result = left * right;

            sprintf(nums[i], "%g", result);
            tokens[i - 1] = nums[i];

            for (j = i; j < count - 2; j++) {
                tokens[j] = tokens[j + 2];
            }
            count -= 2;
        } else {
            i++;
        }
    }
    printf("After multiplication: ");
    for (k = 0; k < count; k++) {
        printf("%s ", tokens[k]);
    }
    printf("\n");
    double final_result = atof(tokens[0]);
    for (k = 1; k < count; k += 2) {
        if (strcmp(tokens[k], "+") == 0) {
            final_result += atof(tokens[k + 1]);
        } else if (strcmp(tokens[k], "-") == 0) {
            final_result -= atof(tokens[k + 1]);
        }
    }
    printf("Result = %g\n", final_result);
    return 0;
}
