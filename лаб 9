#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <ctype.h>

int main() {
    char str[256];
    double result = 0, num;
    char plus = '+';
    int i = 0;
    
    printf("Enter the expression: ");
    fgets(str, sizeof(str), stdin);
    
    while (str[i] != '\0') {
        while (str[i] == ' ') i++;
        
        if (str[i] == '+' || str[i] == '-') {
            plus = str[i];
            i++;
            while (str[i] == ' ') i++;
        }
        
        num = strtod(&str[i], NULL);
        
        if (plus == '+') result += num;
        else result -= num;
        
        while (str[i] != '\0' && str[i] != '+' && str[i] != '-') i++;
    }
    
    printf("Result: %g\n", result);
    return 0;
}
