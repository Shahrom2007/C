#include <stdio.h>
#include <string.h>
#include <stdlib.h>

int main() {
    char str[256];
    double result = 0;
    double num;
    char *token;
    char sign = '+';
////////////////////////////////////////////
    printf("Enter expression: ");
    fgets(str, 256, stdin);
    str[strcspn(str, "\n")] = 0;  
/////////////parsing strings
    token = strtok(str, " ");
///////////////////////////////////////////////
    if (token[0] == '-') {
        sign = '-';
        num = atof(token + 1);
    } else {
        num = atof(token);
    }
    result = (sign == '+') ? num : -num;
////////////////////////////////////////////////////////
    while ((token = strtok(NULL, " ")) != NULL) {
        if (strcmp(token, "+") == 0 || strcmp(token, "-") == 0) {  
            sign = token[0];
            token = strtok(NULL, " ");
            num = atof(token);
            if (sign == '+') result += num;
            else result -= num;
        }
    }
///////////////////////////////////////////////////
    printf("Result: %g\n", result);
    return 0;
}
