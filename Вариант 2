#include <stdio.h>
#include <stdlib.h>
#include <time.h>
int main() {
    int N, M;
    // Ввод данных
    printf("Введите количество чисел (N): ");
    scanf("%d", &N);
    printf("Введите количество столбцов матрицы (M): ");
    scanf("%d", &M);
    // Начинаем замер времени
    clock_t start_time = clock();
    // Инициализация генератора случайных чисел (чтобы числа каждый раз были разными)
    srand(time(NULL));

    // Генерация чисел через rand() и запись в файл ---
    int *numbers = (int*)malloc(N * sizeof(int));
    for (int i = 0; i < N; i++) {
        numbers[i] = rand() % 100 + 1; // Случайные числа от 1 до 100
    }

    FILE *file_in = fopen("input.txt", "w");
    for (int i = 0; i < N; i++) {
        fprintf(file_in, "%d ", numbers[i]);
    }
    fclose(file_in);

    // "Отчистить массивы" по условию
    free(numbers);
    numbers = NULL;

    // задание 1 чтение, замена и запись в output.txt ---
    numbers = (int*)malloc(N * sizeof(int));
    file_in = fopen("input.txt", "r");
    for (int i = 0; i < N; i++) {
        fscanf(file_in, "%d", &numbers[i]);
    }
    fclose(file_in);

    FILE *file_out = fopen("output.txt", "w");
    for (int i = 0; i < N; i++) {
        // Кратность 5 и 7 одновременно проверяется через остаток от деления на 35
        if (numbers[i] % 35 == 0)      fprintf(file_out, "ПЯТЬСЕМЬ ");
        else if (numbers[i] % 5 == 0)  fprintf(file_out, "ПЯТЬ ");
        else if (numbers[i] % 7 == 0)  fprintf(file_out, "СЕМЬ ");
        else                           fprintf(file_out, "%d ", numbers[i]);
    }
    fclose(file_out);

    // задание 2 матрица и подсчет сумм 
    int rows = N / M; // Вычисляем количество полных строк
    
    printf("\nСформированная матрица\n");
    for (int i = 0; i < rows; i++) {
        for (int j = 0; j < M; j++) {
            printf("%d\t", numbers[i * M + j]);
        }
        printf("\n");
    }

    if (rows > 0) {
        printf("\n Результаты сложения\n");
        // Сумма строк
        for (int i = 0; i < rows; i++) {
            int row_sum = 0;
            for (int j = 0; j < M; j++) row_sum += numbers[i * M + j];
            printf("Сумма %d-й строки: %d\n", i + 1, row_sum);
        }
        // Сумма столбцов
        for (int j = 0; j < M; j++) {
            int col_sum = 0;
            for (int i = 0; i < rows; i++) col_sum += numbers[i * M + j];
            printf("Сумма %d-го столбца: %d\n", j + 1, col_sum);
        }
    }

    free(numbers); // Финальная очистка памяти

    // задание 3 замер времени 
    double cpu_time = ((double)(clock() - start_time)) / CLOCKS_PER_SEC;
    printf("\nВремя работы программы: %f секунд\n", cpu_time);

    return 0;
}
