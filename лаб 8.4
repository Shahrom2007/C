#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <locale.h>

struct human {
    char name[64];
    char familyname[64];
    int year;
    char gender[16];
    int height;
};

int compare(struct human a, struct human b, int choices[], int num_choices) {
    int i;
    for (i = 0; i < num_choices; i++) {
        int res = 0;
        switch (choices[i]) {
            case 1: res = strcmp(a.name, b.name); break;
            case 2: res = strcmp(a.familyname, b.familyname); break;
            case 3: res = a.year - b.year; break;
            case 4: res = a.height - b.height; break;
        }
        if (res != 0) return res;
    }
    return 0;
}

int main() {
    setlocale(LC_ALL, "Russian");

    FILE *f1 = fopen("input.txt", "r");
    if (f1 == NULL) {
        printf("error!\n");
        return 1;
    }

    // --- Подсчёт строк ---
    int count = 0;
    char buffer[256];
    while (fgets(buffer, sizeof(buffer), f1) != NULL) {
        if (strlen(buffer) > 1) {
            count++;
        }
    }

    if (count == 0) {
        printf("Файл пуст!\n");
        fclose(f1);
        return 1;
    }

    // !!! ГЛАВНОЕ ИСПРАВЛЕНИЕ: возвращаем указатель в начало файла !!!
    rewind(f1);

    struct human *M1 = malloc(count * sizeof(struct human));
    if (M1 == NULL) {
        printf("error\n");
        fclose(f1);
        return 1;
    }

    // --- Чтение данных ---
    int i = 0;
    while (i < count && fscanf(f1, "%63s %63s %d %15s %d",
           M1[i].name, M1[i].familyname, &M1[i].year,
           M1[i].gender, &M1[i].height) == 5) {
        i++;
    }
    fclose(f1);

    // --- Ввод критериев сортировки ---
    int choices[2];
    printf("1-name 2-familyname 3-year 4-height:\n");
    for (i = 0; i < 2; i++) {
        scanf("%d", &choices[i]);
    }

    // --- Сортировка пузырьком ---
    for (i = 0; i < count - 1; i++) {
        int j;
        for (j = 0; j < count - i - 1; j++) {
            if (compare(M1[j], M1[j + 1], choices, 2) > 0) {
                struct human temp = M1[j];
                M1[j] = M1[j + 1];
                M1[j + 1] = temp;
            }
        }
    }

    // --- Вывод ---
    printf("\nSorted list:\n");
    for (i = 0; i < count; i++) {
        printf("%s %s %d %s %d\n",
               M1[i].name, M1[i].familyname,
               M1[i].year, M1[i].gender, M1[i].height);
    }

    free(M1);
    return 0;
}
