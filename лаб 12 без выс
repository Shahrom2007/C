#include <stdio.h>
#include <string.h>
#include <time.h>

int main() {
    char s[64];
    int y; 
    int m;
    int d;
    struct tm t = {0};

    printf("Enter the date (year.month.day / year.month / year / now): ");
    scanf("%s", s);

    if (strcmp(s, "now") == 0) {
        time_t tod;
        time(&tod);
        printf("Time is %s", ctime(&tod));
        return 0;
    }

    int n = sscanf(s,"%d.%d.%d", &y, &m, &d);

    if (n == 3) { 
        t.tm_year = y - 1900;
        t.tm_mon = m - 1;
        t.tm_mday = d;
        mktime(&t);
        printf("day of the week: %s", asctime(&t));
    }
    else if (n == 2) {  
        t.tm_year = y - 1900;
        t.tm_mon = m - 1;
        t.tm_mday = 1;
        mktime(&t);
        
        int wd = t.tm_wday;
        int days[] = {31, 28, 31, 30, 31, 30, 31, 31, 30, 31, 30, 31};
        
        int off = (wd == 0) ? 6 : wd - 1;
        int i;
        int day;
        
        printf("\n%d.%02d\n", y, m);
        printf("Mo Tu We Th Fr Sa Su\n");
        
        for ( i = 0; i < off; i++) printf("   ");
        
        for ( day = 1; day <= days[m-1]; day++) {
            printf("%2d ", day);
            if ((off + day) % 7 == 0) printf("\n");
        }
        printf("\n");
    }
    else if (n == 1) {  
        int month;
        int i;
        int day;
        for ( month = 1; month <= 12; month++) {
            t.tm_year = y - 1900;
            t.tm_mon = month - 1;
            t.tm_mday = 1;
            mktime(&t);
            
            int wd = t.tm_wday;
            int days[] = {31, 28, 31, 30, 31, 30, 31, 31, 30, 31, 30, 31};
            int off = (wd == 0) ? 6 : wd - 1;
            
            printf("\n%2d.%02d\n", y, month);
            printf("Mo Tu We Th Fr Sa Su\n");
            
            for ( i = 0; i < off; i++) printf("   ");
            
            for ( day = 1; day <= days[month-1]; day++) {
                printf("%2d ", day);
                if ((off + day) % 7 == 0) printf("\n");
            }
            printf("\n");
        }
    }
    return 0;
}
